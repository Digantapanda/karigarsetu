# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose this to the browser or commit it.
# Only used in trusted server contexts (e.g. admin verification actions).
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build shareable profile links and QR codes.
# Set this to your deployed domain in production (e.g. https://karigarsetu.in).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
